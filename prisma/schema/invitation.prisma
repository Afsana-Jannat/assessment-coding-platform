model Invitation {
  id String @id @default(uuid())

  invitedAt DateTime  @default(now())
  expiresAt DateTime?

  status InvitationStatus @default(PENDING)

  message String?

  // Relation with Candidate
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Relation with Assessment
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, assessmentId])
  @@index([candidateId], name: "idx_invitation_candidateId")
  @@index([assessmentId], name: "idx_invitation_assessmentId")
  @@index([status], name: "idx_invitation_status")
  @@index([expiresAt], name: "idx_invitation_expiresAt")
  @@map("invitations")
}
